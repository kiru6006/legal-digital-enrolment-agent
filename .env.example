# AEMS Environment Configuration Template (.env.example)
# Copy this file to .env.local for local development

# Application Mode
VITE_APP_ENV=prototype
VITE_APP_TITLE="AEMS - Bar Council of Tamil Nadu and Puducherry"

# Demo Mode Flags
VITE_ENABLE_MOCK_STORAGE=true
VITE_ENABLE_SIMULATED_AI=true
VITE_ENABLE_BILINGUAL=true

# Future Backend Integration Seams (Phase 8+)
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_TEMPORAL_GRPC_ENDPOINT=localhost:7233
# VITE_POSTGRES_DB_URL=postgresql://aems_user:secret@localhost:5432/aems_db
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
